{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eliware/nodejs-packaging/blob/main/specs/release-record.schema.json",
  "title": "Node.js release record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata_version",
    "schema",
    "release_id",
    "channel",
    "node_version",
    "target",
    "source",
    "package",
    "validation",
    "provenance_path",
    "generation_id",
    "generated"
  ],
  "properties": {
    "metadata_version": { "const": "0.1.0" },
    "schema": { "const": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["stable", "preview"] },
    "node_version": { "type": "string", "pattern": "^26\\.[0-9]+\\.[0-9]+$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version", "repository", "architecture", "format"],
      "properties": {
        "distribution": { "const": "centos-stream" },
        "version": { "const": "10" },
        "repository": { "const": "epel" },
        "architecture": { "const": "x86_64" },
        "format": { "const": "rpm" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "file", "sha256", "signature_url", "signing_key_fingerprint", "verified_at"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "file": { "type": "string", "pattern": "^node-v26\\.[0-9]+\\.[0-9]+-linux-x64\\.tar\\.xz$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "signature_url": { "type": "string", "format": "uri" },
        "signing_key_fingerprint": { "type": "string", "pattern": "^[A-F0-9]{40}$" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "epoch", "version", "release", "architecture", "path", "sha256", "size"],
      "properties": {
        "name": { "const": "nodejs26" },
        "epoch": { "type": ["integer", "null"], "minimum": 0 },
        "version": { "type": "string", "pattern": "^26\\.[0-9]+\\.[0-9]+$" },
        "release": { "type": "string", "minLength": 1 },
        "architecture": { "const": "x86_64" },
        "path": { "type": "string", "pattern": "\\.rpm$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "record_path"],
      "properties": {
        "status": { "const": "passed" },
        "record_path": { "type": "string", "minLength": 1 }
      }
    },
    "provenance_path": { "type": "string", "minLength": 1 },
    "generation_id": { "type": "string", "minLength": 1 },
    "generated": { "type": "string", "format": "date-time" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "base_image", "base_image_digest", "rpm_sha256", "validation", "provenance_path"],
      "properties": {
        "repository": { "const": "ghcr.io/eliware/centos10-node26" },
        "tag": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "base_image": { "const": "quay.io/centos/centos:stream10" },
        "base_image_digest": { "type": "string", "pattern": "^quay.io/centos/centos@sha256:[a-f0-9]{64}$" },
        "rpm_sha256": { "$ref": "#/$defs/sha256" },
        "validation": { "const": "passed" },
        "provenance_path": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
