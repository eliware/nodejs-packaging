{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliware.org/schemas/nodejs/image-record-0.1.0.json",
  "title": "Node.js image record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "tag",
    "digest",
    "base_image",
    "base_image_digest",
    "rpm_sha256",
    "validation",
    "provenance_path"
  ],
  "properties": {
    "repository": {
      "const": "ghcr.io/eliware/centos10-node26"
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "base_image": {
      "const": "quay.io/centos/centos:stream10"
    },
    "base_image_digest": {
      "type": "string",
      "pattern": "^quay.io/centos/centos@sha256:[a-f0-9]{64}$"
    },
    "rpm_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validation": {
      "const": "passed"
    },
    "provenance_path": {
      "type": "string",
      "minLength": 1
    },
    "logs_path": {
      "type": "string",
      "minLength": 1
    }
  }
}
