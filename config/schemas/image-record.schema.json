{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eliware.org/schemas/nodejs/image-record-0.1.0.json",
  "type": "object",
  "required": [
    "repository",
    "tag",
    "digest",
    "base_image_digest",
    "rpm_sha256",
    "validation",
    "provenance_path"
  ],
  "properties": {
    "repository": { "type": "string", "minLength": 1 },
    "tag": { "type": "string", "pattern": "^26\\." },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "base_image_digest": { "type": "string", "minLength": 1 },
    "rpm_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "validation": { "const": "passed" },
    "provenance_path": { "type": "string", "minLength": 1 }
  }
}
